---
// src/components/widgets/Routes.astro
import WidgetLayout from "./WidgetLayout.astro";

// 从配置文件读取线路列表（若未配置则使用默认示例）
// 建议在 src/config.ts 中导出 routesConfig，详见下方说明
import { routesConfig } from "../../config";

// 若配置文件未定义，使用默认示例
const defaultRoutes = [
  { name: "线路 A", value: "a" },
  { name: "线路 B", value: "b" },
  { name: "线路 C", value: "c" },
];

const routes = routesConfig || defaultRoutes;

const COLLAPSED_HEIGHT = "7.5rem";
const isCollapsed = routes.length >= 10; // 可根据需要调整折叠阈值

interface Props {
  class?: string;
  style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout 
  name="线路切换" 
  id="routes" 
  isCollapsed={isCollapsed} 
  collapsedHeight={COLLAPSED_HEIGHT} 
  class={className} 
  style={style}
>
  <div class="flex gap-2 flex-wrap">
    {routes.map(r => (
      <button 
        class="btn-regular h-8 text-sm px-3 rounded-lg route-btn" 
        data-value={r.value}
        aria-label={`切换到 ${r.name}`}
      >
        {r.name}
      </button>
    ))}
  </div>
</WidgetLayout>

<script>
  // 客户端交互：记录选中状态并触发自定义事件
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.route-btn');
    // 从 localStorage 恢复上次选择
    const saved = localStorage.getItem('selectedRoute');
    buttons.forEach(btn => {
      if (saved && btn.dataset.value === saved) {
        btn.classList.add('active');
      }
      btn.addEventListener('click', function(e) {
        buttons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const value = this.dataset.value;
        localStorage.setItem('selectedRoute', value);
        // 触发全局事件，供外部监听切换逻辑
        window.dispatchEvent(new CustomEvent('route-switch', { detail: { value } }));
      });
    });
  });
</script>

<style is:global>
  .route-btn.active {
    background-color: var(--primary);
    color: white;
    /* 若需要边框或阴影可自行添加 */
  }
</style>
