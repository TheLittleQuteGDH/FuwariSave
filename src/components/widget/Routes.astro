---
import WidgetLayout from "./WidgetLayout.astro";

const defaultRoutes = [
  { name: "默认线路", value: "default", domain: "blog.thelittlequtegdh.top" },
  { name: "Cloudflare", value: "cloudflare", domain: "cloudflare.thelittlequtegdh.top" },
  { name: "Edgeone", value: "edgeone", domain: "edgeone.thelittlequtegdh.top" },
  { name: "Netlify", value: "netlify", domain: "netlify.thelittlequtegdh.top" },
];

const routes = defaultRoutes;
const COLLAPSED_HEIGHT = "7.5rem";
const isCollapsed = routes.length >= 10;

interface Props {
  class?: string;
  style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout 
  name="线路切换" 
  id="routes" 
  isCollapsed={isCollapsed} 
  collapsedHeight={COLLAPSED_HEIGHT} 
  class={className} 
  style={style}
>
  <div class="flex flex-col gap-4">
    {routes.map(r => (
      <button 
        class="route-btn w-full flex items-center justify-between btn-regular h-10 px-4 rounded-lg text-left" 
        data-value={r.value}
        data-domain={r.domain}
        aria-label={`切换到 ${r.name}`}
      >
        <span class="flex-1 text-sm">{r.name}</span>
        <span class="delay-indicator w-4 h-4 rounded-full border-2 border-gray-400 flex items-center justify-center flex-shrink-0">
          <span class="delay-dot w-2 h-2 rounded-full bg-gray-300"></span>
        </span>
      </button>
    ))}
  </div>
  <div class="text-xs text-gray-400 mt-2 text-center">切换线路以访问不同节点</div>
</WidgetLayout>

<script>
  (function() {
    const hostnameMap = {
      'blog.thelittlequtegdh.top': 'default',
      'cloudflare.thelittlequtegdh.top': 'cloudflare',
      'edgeone.thelittlequtegdh.top': 'edgeone',
      'netlify.thelittlequtegdh.top': 'netlify',
    };
    const currentHost = window.location.hostname;
    const currentRoute = hostnameMap[currentHost] || 'default';
    localStorage.setItem('selectedRoute', currentRoute);

    const buttons = document.querySelectorAll('.route-btn');
    const dotElements = document.querySelectorAll('.delay-dot');
    const domainMap = {};
    buttons.forEach((btn, idx) => {
      const domain = btn.dataset.domain;
      domainMap[domain] = { btn, dot: dotElements[idx] };
    });

    function testDelay(domain) {
      const url = `https://${domain}/?t=${Date.now()}`;
      const start = performance.now();
      return fetch(url, { method: 'HEAD', mode: 'cors' })
        .then(() => {
          const end = performance.now();
          return Math.round(end - start);
        })
        .catch(() => Infinity);
    }

    function updateDot(dot, delay) {
      let color;
      if (delay <= 50) color = 'bg-green-700';
      else if (delay <= 100) color = 'bg-green-300';
      else if (delay <= 200) color = 'bg-yellow-400';
      else if (delay <= 250) color = 'bg-red-500';
      else color = 'bg-gray-400';
      dot.className = 'w-2 h-2 rounded-full ' + color + ' delay-dot';
    }

    const cacheKey = 'delayCache';
    const cacheStr = localStorage.getItem(cacheKey);
    const cache = cacheStr ? JSON.parse(cacheStr) : {};
    const now = Date.now();
    const expireTime = 30 * 1000;

    function refreshAllDelays() {
      const now = Date.now();
      const domains = Object.keys(domainMap);
      const promises = domains.map(domain => {
        return testDelay(domain).then(delay => {
          updateDot(domainMap[domain].dot, delay);
          cache[domain] = { delay, time: now };
        }).catch(() => {});
      });
      Promise.allSettled(promises).then(() => {
        localStorage.setItem(cacheKey, JSON.stringify(cache));
      });
    }

    const promises = [];
    for (const domain in domainMap) {
      const cached = cache[domain];
      if (cached && (now - cached.time) < expireTime) {
        updateDot(domainMap[domain].dot, cached.delay);
      } else {
        promises.push(
          testDelay(domain).then(delay => {
            updateDot(domainMap[domain].dot, delay);
            cache[domain] = { delay, time: now };
          }).catch(() => {})
        );
      }
    }
    Promise.allSettled(promises).then(() => {
      localStorage.setItem(cacheKey, JSON.stringify(cache));
    });

    if (window._delayTimer) clearInterval(window._delayTimer);
    window._delayTimer = setInterval(refreshAllDelays, expireTime);

    buttons.forEach(btn => {
      if (btn.dataset.value === currentRoute) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    buttons.forEach(btn => {
      btn.addEventListener('click', function() {
        const value = this.dataset.value;
        localStorage.setItem('selectedRoute', value);
        window.dispatchEvent(new CustomEvent('route-switch', { detail: { value } }));
      });
    });
  })();
</script>

<style is:global>
  @keyframes pulse-dot {
    0% { transform: scale(1); opacity: 0.7; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(1); opacity: 0.7; }
  }
  .delay-dot {
    animation: pulse-dot 2s ease-in-out infinite;
  }
  .route-btn.active {
    background-color: var(--primary);
    color: white;
  }
  .route-btn.active .delay-indicator {
    border-color: white;
  }
  .route-btn.active .delay-dot {
    border-color: white;
  }
  .delay-indicator {
    border: 2px solid #9ca3af;
  }
</style>
